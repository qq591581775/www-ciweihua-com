{
  "name": "www-ciweihua-com",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate && node scripts/export-dist.mjs",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:dist": "node scripts/verify-dist.mjs",
    "ci:local": "node scripts/require-clean-worktree.mjs && npm run lint && npm run format:check && npm run typecheck && npm test && npm run generate && npm run verify:dist && node scripts/check-dist-clean.mjs && bash -n webhook.sh",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "^4.6.4",
    "vue": "^3.5.24",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.2",
    "vue-tsc": "^3.1.4"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
